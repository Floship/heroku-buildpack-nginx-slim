#!/usr/bin/env bash
set -euo pipefail

build_dir=$1
buildpack_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
stack=${STACK:-heroku-26}
arch=$(dpkg --print-architecture)
tarball="${buildpack_dir}/nginx-${stack}-${arch}.tgz"

if [ ! -f "$tarball" ]; then
    echo "nginx-buildpack: unsupported stack/architecture: ${stack}/${arch}" >&2
    exit 1
fi

tmp=$(mktemp -d -t nginx-buildpack.XXXXXXXXXX)
trap 'rm -rf -- "$tmp"' EXIT
tar -xzf "$tarball" -C "$tmp"

mkdir -p "$build_dir/bin" "$build_dir/config"
install -m 755 "$tmp/nginx" "$build_dir/bin/nginx"
if [ ! -f "$build_dir/config/mime.types" ]; then
    install -m 644 "$tmp/mime.types" "$build_dir/config/mime.types"
fi
install -m 755 "$buildpack_dir/bin/start-nginx" "$build_dir/bin/start-nginx"

echo '-----> nginx-buildpack-slim: Installed nginx without Ruby'

# The app's Node dependencies are build-time inputs. Keeping them in the slug
# adds hundreds of megabytes and no runtime value. This replaces the separate
# heroku-buildpack-node-modules-cleanup buildpack.
echo '-----> nginx-buildpack-slim: Removing node_modules'
find "$build_dir" -name 'node_modules' -type d -prune -print -exec rm -rf '{}' \;

if [ "${FLOSHIP_INSTALL_HEROKU_CLI:-0}" = "1" ]; then
    cli_url='https://cli-assets.heroku.com/versions/9.5.1/1aaf605/heroku-v9.5.1-1aaf605-linux-x64.tar.xz'
    cli_sha256='ffc906cc7de50d78837fbc9aa706ceda2c3eabe7f9409b5509d253e7d9d621d5'
    cli_archive="${tmp}/heroku-cli.tar.xz"

    echo '-----> nginx-buildpack-slim: Installing Heroku CLI for review app'
    curl --fail --silent --show-error --retry 3 --retry-connrefused \
        "${cli_url}" -o "${cli_archive}"
    printf '%s  %s\n' "${cli_sha256}" "${cli_archive}" | sha256sum -c -

    mkdir -p "${build_dir}/.heroku/cli" "${build_dir}/.heroku/bin" "${build_dir}/.profile.d"
    tar -xJf "${cli_archive}" -C "${build_dir}/.heroku/cli" --strip-components 1
    ln -sfn '../cli/bin/heroku' "${build_dir}/.heroku/bin/heroku"
    cat >"${build_dir}/.profile.d/heroku-cli.sh" <<'PROFILE'
export PATH="$PATH:$HOME/.heroku/bin"
export HEROKU_SKIP_ANALYTICS=1
export HEROKU_DISABLE_AUTOUPDATE=1
PROFILE
    chmod +x "${build_dir}/.profile.d/heroku-cli.sh"
    "${build_dir}/.heroku/bin/heroku" version
fi
